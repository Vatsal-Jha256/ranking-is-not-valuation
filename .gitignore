# Public code release. New top-level paths are excluded until listed here.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/.github/
!/CITATION.cff
!/Dockerfile
!/LICENSE
!/README.md
!/pyproject.toml
!/reproduce.sh

!/docs/
/docs/*
!/docs/CODE_MAP.md
!/docs/DATA_ACCESS.md
!/docs/PREPROCESSING.md

!/rnv/
!/tests/

!/experiments/
/experiments/*
!/experiments/README.md
!/experiments/protocols/
!/experiments/selection_gap/
!/experiments/model_robustness/
!/experiments/calibration_premise/
!/experiments/reporting_policies/
!/experiments/pool_sensitivity/
!/experiments/temporal_holdout/
!/experiments/supplementary/
/experiments/supplementary/*
!/experiments/supplementary/README.md
!/experiments/supplementary/run_beta_shrinkage.py
!/experiments/supplementary/run_budget_allocation.py

!/results/
/results/*
!/results/exp_submission_harmonized_v4.json
!/results/exp_model_robustness_v3.json
!/results/exp_calibration_structure_v1.json
!/results/exp_uncertainty_policies_v1.json
!/results/exp_candidate_sensitivity_v1.json
!/results/exp_temporal_holdout_v1.json
!/results/exp_beta_shrinkage_v2.json
!/results/exp_knapsack_v2.json
!/results/exp_stratified_quantile_v1.json

!/figures/
/figures/*
!/figures/gen_submission_figure.py
!/figures/gen_appendix_figures.py
!/figures/figstyle.py
!/figures/fig1_rank_then_report.pdf
!/figures/fig1_rank_then_report.svg
!/figures/fig1_submission_story.pdf
!/figures/figA1_premise_audit.pdf
!/figures/figA2_selection_vs_reporting.pdf
!/figures/figA3_pool_sensitivity.pdf
!/figures/figA4_temporal_holdout.pdf
!/figures/figA5_accepted_policies.pdf
!/figures/figA6_supplementary_checks.pdf
!/figures/specs/
/figures/specs/*
!/figures/specs/fig1_rank_then_report.json

!/reproducibility/
/reproducibility/*
!/reproducibility/CONTEXTUAL_DATA_SNAPSHOTS.md
!/reproducibility/EXPERIMENT_INCLUSION_AUDIT.md
!/reproducibility/LAST_VERIFIED_RUN.md
!/reproducibility/README.md
!/reproducibility/SOURCE_PROVENANCE.md
!/reproducibility/check_results.py
!/reproducibility/generate_manifest.py
!/reproducibility/input_manifest.json
!/reproducibility/requirements.in
!/reproducibility/requirements.lock
!/reproducibility/run_locked.sh
!/reproducibility/verify_outputs.py

**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

!/scripts/
/scripts/*
!/scripts/prepare_data.py
!/scripts/run_new_data.py
